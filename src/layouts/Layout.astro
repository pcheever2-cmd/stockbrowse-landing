---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Browse stocks like products. Invest with clarity. Every stock rated 0-100." } = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="description" content={description} />
  <meta name="generator" content={Astro.generator} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  <title>{title}</title>

  <!-- Google Analytics -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XB4GFRNE80"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-XB4GFRNE80');
  </script>

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700;800&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      --bg-primary: #080A0F;
      --bg-surface: #161B24;
      --bg-elevated: #1C222E;
      --text-primary: #F1F5F9;
      --text-secondary: #CBD5E1;
      --text-muted: #64748B;
      --accent-cyan: #22D3EE;
      --accent-cyan-dark: #06B6D4;
      --border: rgba(255, 255, 255, 0.06);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* Header */
    .header {
      padding: 1.5rem 0;
      border-bottom: 1px solid var(--border);
      background: rgba(12, 15, 20, 0.8);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
    }

    .logo-icon {
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.5rem;
      background: linear-gradient(135deg, var(--accent-cyan), var(--accent-cyan-dark));
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--bg-primary);
      font-weight: 900;
      font-size: 1.125rem;
    }

    .logo-text {
      font-family: 'JetBrains Mono', monospace;
      font-size: 1.25rem;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .logo-text .brand {
      color: var(--text-primary);
    }

    .logo-text .accent {
      color: var(--accent-cyan);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 2rem;
    }

    .nav-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.9375rem;
      font-weight: 500;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--text-primary);
    }

    .nav-links a.active {
      color: var(--accent-cyan);
    }

    /* Footer */
    .footer {
      border-top: 1px solid var(--border);
      padding: 3rem 0;
      text-align: center;
    }

    .footer-content {
      max-width: 600px;
      margin: 0 auto;
    }

    .footer-logo {
      margin-bottom: 1rem;
      display: flex;
      justify-content: center;
    }

    .footer p {
      color: var(--text-muted);
      font-size: 0.875rem;
      margin-bottom: 2rem;
    }

    .powered-by {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    .powered-by strong {
      color: var(--accent-cyan);
    }

    /* Responsive */
    @media (max-width: 768px) {
      .nav-links {
        display: none;
      }
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header class="header">
    <div class="container header-inner">
      <a href="/" class="logo">
        <div class="logo-icon">S</div>
        <div class="logo-text">
          <span class="brand">Stock</span><span class="accent">browse</span>
        </div>
      </a>
      <nav class="nav-links">
        <a href="/blog">Learn</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <div class="footer-content">
        <div class="footer-logo">
          <a href="/" class="logo">
            <div class="logo-icon">S</div>
            <div class="logo-text">
              <span class="brand">Stock</span><span class="accent">browse</span>
            </div>
          </a>
        </div>
        <p>Browse stocks like products. Invest with clarity.</p>
        <div class="powered-by">
          Powered by the <strong>Compass Score</strong>
        </div>
      </div>
    </div>
  </footer>
</body>
</html>
