---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Related articles from the same category
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.data.category === post.data.category && p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Layout title={`${post.data.title} | Stockbrowse`} description={post.data.description}>
  <style is:global>
    .article-header {
      padding: 4rem 0 2rem;
      background: var(--bg-surface);
    }

    .article-header .container {
      max-width: 800px;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.875rem;
      margin-bottom: 2rem;
      transition: color 0.2s;
    }

    .back-link:hover {
      color: var(--accent-cyan);
    }

    .article-date {
      color: var(--accent-cyan);
      font-size: 0.875rem;
      font-weight: 600;
      margin-bottom: 0.75rem;
    }

    .article-title {
      font-size: 2.5rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 1rem;
    }

    .article-description {
      font-size: 1.25rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .article-content {
      padding: 3rem 0 4rem;
    }

    .article-content .container {
      max-width: 800px;
    }

    .prose {
      color: var(--text-secondary);
      font-size: 1.125rem;
      line-height: 1.85;
    }

    .prose > * + * {
      margin-top: 1.5em;
    }

    .prose h2 {
      color: var(--text-primary);
      font-size: 1.75rem;
      font-weight: 700;
      margin-top: 2.5rem;
      margin-bottom: 1.25rem;
      line-height: 1.3;
    }

    .prose h3 {
      color: var(--text-primary);
      font-size: 1.25rem;
      font-weight: 600;
      margin-top: 2rem;
      margin-bottom: 1rem;
      line-height: 1.4;
    }

    .prose p {
      margin-top: 1.25em;
      margin-bottom: 1.25em;
    }

    .prose ul, .prose ol {
      margin-top: 1.5em;
      margin-bottom: 1.5em;
      padding-left: 1.75rem;
    }

    .prose li {
      margin-top: 0.75em;
      margin-bottom: 0.75em;
      padding-left: 0.5em;
    }

    .prose li::marker {
      color: var(--text-muted);
    }

    .prose strong {
      color: var(--text-primary);
      font-weight: 600;
    }

    .prose a {
      color: var(--accent-cyan);
      text-decoration: none;
    }

    .prose a:hover {
      text-decoration: underline;
    }

    .prose hr {
      border: none;
      border-top: 1px solid var(--border);
      margin: 2.5rem 0;
    }

    .prose em {
      font-style: italic;
    }

    .prose blockquote {
      border-left: 3px solid var(--accent-cyan);
      padding-left: 1.5rem;
      margin: 1.5rem 0;
      color: var(--text-muted);
    }

    @media (max-width: 768px) {
      .article-title {
        font-size: 1.75rem;
      }

      .article-description {
        font-size: 1.125rem;
      }

      .prose {
        font-size: 1rem;
      }
    }

    .blog-cta {
      margin-top: 3.5rem;
      background: var(--bg-surface);
      border: 1px solid rgba(34, 211, 238, 0.2);
      border-radius: 0.75rem;
      padding: 2rem;
      text-align: center;
    }

    .blog-cta-title {
      color: var(--text-primary);
      font-weight: 700;
      font-size: 1.25rem;
      margin-bottom: 0.5rem;
    }

    .blog-cta-sub {
      color: var(--text-secondary);
      margin-bottom: 1.25rem;
    }

    .blog-cta-btn {
      display: inline-block;
      background: var(--accent-cyan);
      color: var(--bg-primary);
      padding: 0.75rem 1.5rem;
      border-radius: 0.5rem;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.2s;
    }

    .blog-cta-btn:hover {
      background: var(--accent-cyan-dark);
    }

    .related {
      margin-top: 3rem;
    }

    .related-title {
      color: var(--text-primary);
      font-weight: 700;
      font-size: 1.25rem;
      margin-bottom: 1rem;
    }

    .related-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .related-card {
      display: block;
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      padding: 1rem 1.25rem;
      text-decoration: none;
      transition: border-color 0.2s;
    }

    .related-card:hover {
      border-color: rgba(34, 211, 238, 0.3);
    }

    .related-card-title {
      color: var(--text-primary);
      font-weight: 600;
      margin-bottom: 0.25rem;
    }

    .related-card-desc {
      color: var(--text-muted);
      font-size: 0.9rem;
    }
  </style>

  <header class="article-header">
    <div class="container">
      <a href="/blog" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        Back to Learn
      </a>
      <p class="article-date">
        {post.data.pubDate.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
      </p>
      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
    </div>
  </header>

  <article class="article-content">
    <div class="container">
      <div class="prose">
        <Content />
      </div>

      <div class="blog-cta">
        <p class="blog-cta-title">Stockbrowse launches Spring 2026</p>
        <p class="blog-cta-sub">Browse stocks by industry, filter by quality, and skip the ticker-symbol guessing game. Join the waitlist to get in first.</p>
        <a href="/" class="blog-cta-btn">Join the waitlist →</a>
      </div>

      {relatedPosts.length > 0 && (
        <div class="related">
          <h3 class="related-title">Keep reading</h3>
          <div class="related-list">
            {relatedPosts.map((p) => (
              <a href={`/blog/${p.id.replace(/\.md$/, '')}`} class="related-card">
                <p class="related-card-title">{p.data.title}</p>
                <p class="related-card-desc">{p.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</Layout>
